{
  "name": "chrome-extension-react-hello",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "unset:git-hooks-path": "git config --unset core.hooksPath",
    "simple-git-hooks": "npx simple-git-hooks",
    "postinstall": "is-ci || npm run simple-git-hooks",
    "prettify": "prettier --write .",
    "lint": "eslint --cache --fix .",
    "start": "vite",
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview"
  },
  "dependencies": {
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "tailwindcss": "4.1.13"
  },
  "devDependencies": {
    "@crxjs/vite-plugin": "2.2.0",
    "@eslint/js": "9.36.0",
    "@tailwindcss/vite": "4.1.13",
    "@types/chrome": "0.1.12",
    "@types/node": "24.5.2",
    "@types/react": "19.1.15",
    "@types/react-dom": "19.1.9",
    "@vitejs/plugin-react": "5.0.4",
    "eslint": "9.36.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-prettier": "5.5.4",
    "eslint-plugin-react-hooks": "5.2.0",
    "eslint-plugin-react-refresh": "0.4.22",
    "globals": "16.4.0",
    "is-ci": "4.1.0",
    "lint-staged": "16.2.3",
    "prettier": "3.6.2",
    "prettier-plugin-tailwindcss": "0.6.14",
    "simple-git-hooks": "2.13.1",
    "typescript": "~5.9.0",
    "typescript-eslint": "8.44.1",
    "vite": "7.1.7",
    "vite-plugin-zip-pack": "1.2.4",
    "vite-tsconfig-paths": "5.1.4"
  },
  "lint-staged": {
    "src/**/*.{js,jsx,ts,tsx,md,html,css,scss}": "prettier --write",
    "src/**/*.{js,jsx,ts,tsx}": "eslint --fix"
  },
  "simple-git-hooks": {
    "pre-commit": "npx lint-staged"
  }
}
